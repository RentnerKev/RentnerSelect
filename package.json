{
    "name": "@rentnerkev/select",
    "version": "1.0.0",
    "description": "Accessible, searchable React select with single and multiple selection support.",
    "author": "RentnerKev",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json",
        "test": "bun test",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerSelect.git"
    },
    "homepage": "https://github.com/RentnerKev/RentnerSelect#readme",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerSelect/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.5",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.2.4",
        "happy-dom": "^20.14.5",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "lucide-react": "^1.47.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./select": {
            "import": "./dist/Select.js",
            "types": "./dist/Select.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "types": "./dist/types.d.ts"
        }
    },
    "packageManager": "bun@1.4.2"
}
