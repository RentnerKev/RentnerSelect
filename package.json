{
    "name": "@rentnerkev/select",
    "version": "5.3.0",
    "description": "Accessible, searchable React select with single and multiple selection support.",
    "author": "RentnerKev",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css",
        "README.md",
        "docs/usage.md",
        "theme.css"
    ],
    "sideEffects": [
        "./tailwind.css",
        "./theme.css"
    ],
    "scripts": {
        "benchmark": "bun scripts/benchmark.mjs",
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json && bun run typecheck:playground && bun run typecheck:automation",
        "test": "bun test",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "pack:consumer": "node scripts/consumer/verify.mjs",
        "playground:install": "bun install --cwd playground --frozen-lockfile",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "e2e": "playwright test",
        "lint": "oxlint --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "lint:fix": "oxlint --fix --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "format": "bun fmt src scripts playground/src .github/scripts docs README.md package.json tsconfig.json tsconfig.type-tests.json playground/tsconfig.json playground/package.json playground/vite.config.ts playwright.config.ts .oxlintrc.json bunfig.toml theme.css tailwind.css benchmarks",
        "format:check": "bun fmt --check src scripts playground/src .github/scripts docs README.md package.json tsconfig.json tsconfig.type-tests.json playground/tsconfig.json playground/package.json playground/vite.config.ts playwright.config.ts .oxlintrc.json bunfig.toml theme.css tailwind.css benchmarks",
        "verify": "bun run playground:install && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run pack:consumer && bun run e2e",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json",
        "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerSelect.git"
    },
    "homepage": "https://packages.rentner.dev/packages/select",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerSelect/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@happy-dom/global-registrator": "^21.0.4",
        "@playwright/test": "^1.64.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "happy-dom": "^21.0.4",
        "oxlint": "^1.89.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@rentnerkev/tooltips": "^2.2.0",
        "lucide-react": "^1.61.0",
        "@tanstack/react-virtual": "^3.14.23"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./select": {
            "import": "./dist/shared/Select/Components/CustomSelect.js",
            "types": "./dist/shared/Select/Components/CustomSelect.d.ts"
        },
        "./value": {
            "import": "./dist/lib/Select/selectValue.js",
            "types": "./dist/lib/Select/selectValue.d.ts"
        },
        "./messages": {
            "import": "./dist/lib/Messages/i18n.js",
            "types": "./dist/lib/Messages/i18n.d.ts"
        },
        "./types": {
            "import": "./dist/shared/Select/Types/select.types.js",
            "types": "./dist/shared/Select/Types/select.types.d.ts"
        },
        "./package.json": "./package.json",
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.js"
        },
        "./theme.css": "./theme.css",
        "./combobox": {
            "types": "./dist/shared/Combobox/Components/Combobox.d.ts",
            "import": "./dist/shared/Combobox/Components/Combobox.js"
        },
        "./form": {
            "types": "./dist/lib/Form/selectForm.d.ts",
            "import": "./dist/lib/Form/selectForm.js"
        },
        "./combobox/types": {
            "types": "./dist/shared/Combobox/Types/combobox.types.d.ts",
            "import": "./dist/shared/Combobox/Types/combobox.types.js"
        }
    },
    "packageManager": "bun@1.4.4"
}
